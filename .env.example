# Copy to .env and fill in. Get keys from Razorpay Dashboard → Settings → API Keys.

# Server-side only (Vercel Functions). NEVER expose the secret to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public key id, exposed to the browser by Vite. Must match RAZORPAY_KEY_ID.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Kundli PDF export — branding printed on the report's last page
PROSPECTIQ_EMAIL_FROM=noreply@yourdomain.com
PDF_COMPANY_NAME=JyotishNow
PDF_ADDRESS=Your address
PDF_WEBSITE=www.example.com
PDF_EMAIL=mail@example.com
PDF_PHONE=+91 0000000000
